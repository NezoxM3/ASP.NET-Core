<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] — Моя сторінка</title>
    <link rel="stylesheet" href="~/css/site.css">
</head>
<body>
    <header class="site-header">
        <nav class="nav">
            <a class="brand" href="/">Моя сторінка</a>
            <div class="nav-links">
                <a href="/">Про мене</a>
                <a href="/message">Повідомлення</a>
            </div>
        </nav>
    </header>

    <main class="container">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <p>© @DateTime.Now.Year · Зроблено на ASP.NET Core</p>
    </footer>
</body>
</html>
